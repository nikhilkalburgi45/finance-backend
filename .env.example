# ── Option A: Neon / Remote PostgreSQL ──────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# ── Option B: Local Docker PostgreSQL (matches docker-compose.yml defaults) ───
# DATABASE_URL="postgresql://finance_user:finance_pass@db:5432/finance_db"
# Use this when running the app inside Docker via docker-compose

JWT_SECRET="your_jwt_secret_key_here_make_it_long_and_random"
JWT_EXPIRES_IN="7d"
PORT=3000
NODE_ENV=development

# Only required if using the local Docker postgres service
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=finance_pass
POSTGRES_DB=finance_db
